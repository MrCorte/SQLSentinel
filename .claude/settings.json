{
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(git *)",
      "Bash(mkdir *)",
      "Read(**)",
      "Edit(**)",
      "Write(**)"
    ],
    "deny": [
      "Bash(rm -rf *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit(src/**/*.{ts,tsx})",
        "hooks": [
          {
            "type": "command",
            "command": "npm run typecheck 2>&1 | tail -5"
          }
        ]
      },
      {
        "matcher": "Edit(src/**/*.{ts,tsx})",
        "hooks": [
          {
            "type": "command",
            "command": "npx prettier --write \"%CLAUDE_TOOL_INPUT_FILE_PATH%\" 2>&1"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit(.env*)",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'ERROR: Direct .env edits blocked. Store credentials via electron-store.' && exit 1"
          }
        ]
      },
      {
        "matcher": "Edit(package-lock.json)",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'ERROR: Do not edit package-lock.json directly. Use npm install.' && exit 1"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "context7@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "coderabbit@claude-plugins-official": true
  }
}
