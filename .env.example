# Copy this file to .env and set strong, unique local secrets.
# Do not commit .env.
#
# SQL Server passwords must satisfy the container image password policy:
# at least 8 chars and at least 3 of uppercase, lowercase, digits, symbols.

SQLSENTINEL_DOCK_USER=<set-docker-admin-login>
SQLSENTINEL_DOCK_PASSWORD=<generate-strong-password>
SQLSENTINEL_APP_USER=<set-app-login>
SQLSENTINEL_APP_PASSWORD=<generate-strong-password>
SQLSENTINEL_MONITOR_USER=<set-monitor-login>
SQLSENTINEL_MONITOR_PASSWORD=<generate-strong-password>

SQLSENTINEL_STORAGE_SA_PASSWORD=<generate-strong-password>
SQLSENTINEL_PROD_SA_PASSWORD=<generate-strong-password>
SQLSENTINEL_DEV_SA_PASSWORD=<generate-strong-password>
SQLSENTINEL_STAGING_SA_PASSWORD=<generate-strong-password>
SQLSENTINEL_DR_SA_PASSWORD=<generate-strong-password>
